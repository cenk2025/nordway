# ============================================================================
# Nordway — environment variables. Copy this file to `.env.local` and fill in.
# `.env.local` is gitignored and must NEVER be committed. Secrets (service role,
# Anthropic key) are server-only — never prefix them with NEXT_PUBLIC_.
# ============================================================================

# --- Supabase ---
# Project URL, e.g. https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Public anon key (safe to expose; RLS enforced)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role key — SERVER ONLY. Bypasses RLS. Used for trusted operations
# (e.g. account deletion, admin tooling). Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- App ---
# Public base URL, used for auth redirect callbacks. No trailing slash.
# Production: https://nordway.voon.fi
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- AI (Anthropic) — SERVER ONLY ---
# Powers the eligibility assistant (chatbot) and the admin AI case-assessment
# draft. Without it those features degrade gracefully. Never prefix NEXT_PUBLIC_.
# Get a key at https://console.anthropic.com → API Keys.
ANTHROPIC_API_KEY=your-anthropic-api-key
# Premium model — deep reasoning (admin case assessment). Defaults to
# claude-fable-5 (Anthropic's most capable; requires 30-day data retention, not
# available under ZDR, costs more than Opus-tier).
ANTHROPIC_MODEL=claude-fable-5
# Fast model — latency-sensitive, high-volume calls (the chatbot). Defaults to
# claude-opus-4-8.
ANTHROPIC_FAST_MODEL=claude-opus-4-8

# --- Email (Resend) — SERVER ONLY. Without a key, all emails silently no-op. ---
RESEND_API_KEY=your-resend-api-key
# Verified sender, e.g. "Nordway <noreply@nordway.voon.fi>" (defaults to resend.dev sandbox)
RESEND_FROM=Nordway <noreply@nordway.voon.fi>
# Where new-case / accepted-quote alerts are sent
NORDWAY_ADMIN_EMAIL=you@example.com

# --- Rate limiting (Upstash Redis) — SERVER ONLY ---
# Required on Vercel/serverless for the chatbot's rate limit to actually work
# across instances (without it, a per-instance in-memory fallback is used,
# which is NOT a real cap in production — set this before launch). Create a
# free Redis database at https://console.upstash.com and paste its REST
# credentials here (Vercel's Upstash integration fills these in automatically
# if you add it from the Vercel Marketplace instead).
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token

# --- Feature flags ---
# Show Swedish (sv) and Norwegian (no) locales in the language switcher as
# active rather than "coming soon". Off by default for Phase 1 launch.
NEXT_PUBLIC_FEATURE_LOCALES_SV_NO=false
# Let search engines index the site (robots.txt + X-Robots-Tag). Keep false
# until public launch.
NEXT_PUBLIC_ALLOW_INDEXING=false
